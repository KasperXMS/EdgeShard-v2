# EdgeShard Jetson shard image.
#
# Validated target:
#   JetPack 7.2.1
#   L4T R39.2.1
#   Ubuntu 24.04
#   aarch64
#   NVIDIA Orin
#
# The host owns the kernel, NVIDIA driver, JetPack/L4T, Docker and
# NVIDIA Container Toolkit.  The NVIDIA PyTorch container supplies
# the Jetson-compatible PyTorch/CUDA userspace stack.
#
# Models are mounted read-only at /models and are never baked into
# the image.

FROM nvcr.io/nvidia/pytorch:25.08-py3

COPY --from=ghcr.io/astral-sh/uv:0.12.7 \
    /uv /uvx /usr/local/bin/

# Keep EdgeShard packages isolated while reusing NVIDIA's system
# PyTorch/CUDA installation.
RUN python3 -m venv \
      --system-site-packages \
      /opt/edgeshard

ENV PATH="/opt/edgeshard/bin:${PATH}"

WORKDIR /app

COPY pyproject.toml uv.lock ./

# uv.lock is still the dependency source of truth.
# Torch is deliberately excluded because the NVIDIA Jetson image
# provides its own architecture-specific CUDA build.
RUN uv export \
      --frozen \
      --no-dev \
      --no-emit-project \
      --no-emit-package torch \
      --format requirements-txt \
      --output-file /tmp/requirements.txt \
 && pip install \
      --no-cache-dir \
      -r /tmp/requirements.txt

COPY src ./src

RUN pip install \
      --no-cache-dir \
      --no-deps \
      .

ENTRYPOINT ["edgeshard"]
CMD ["--config", "/runtime/config/runtime.yaml"]