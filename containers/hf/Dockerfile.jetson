# EdgeShard Jetson shard image (spec 21.4) — pinned scaffold.
#
# The Jetson host retains kernel, NVIDIA driver, JetPack/L4T, Docker, and the
# NVIDIA Container Toolkit; application dependencies live here. The base is an
# L4T-compatible PyTorch image (JetPack 6 / L4T R36) whose torch build is
# aarch64/L4T-specific — the project uv.lock cannot apply (it resolves x86_64
# CPU torch), so every non-torch dependency is pinned explicitly to the
# versions the lock records instead.
#
# This scaffold is validated on the target JetPack/L4T environment (Tier 3,
# spec 26); treat pin drift here as expected until that validation lands.
#
# Run on the Jetson host:
#
#   docker run --rm --runtime nvidia \
#     -v "$EDGESHARD_MODEL_CACHE:/models:ro" \
#     -v "$PWD/stage.yaml:/runtime/config/runtime.yaml:ro" \
#     -p 9100:9100 \
#     edgeshard/hf-shard:jetson

FROM dustynv/l4t-pytorch:r36.4.0

WORKDIR /app

# Pinned from uv.lock (everything except torch; L4T supplies torch).
RUN pip3 install --no-cache-dir \
      "transformers==5.16.1" \
      "accelerate==1.14.0" \
      "safetensors==0.8.0" \
      "huggingface-hub==1.29.0" \
      "pydantic==2.13.5" \
      "pyyaml==6.0.3" \
      "grpcio==1.83.1" \
      "protobuf==7.36.0" \
      "typer==0.27.2" \
      "httpx==0.28.1" \
      "numpy==2.5.2"

COPY src ./src

# L4T R36 ships Python 3.10, so the project is run from sources instead of a
# pip install (the package declares requires-python >= 3.12); edgeshard's
# StrEnum backport (inference/state.py) covers the 3.10 interpreter.
ENV PYTHONPATH="/app/src"

ENTRYPOINT ["python3", "-m", "edgeshard"]
CMD ["--config", "/runtime/config/runtime.yaml"]
