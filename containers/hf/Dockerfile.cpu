# EdgeShard CPU correctness image (spec 21.2).
#
# Purpose: CI, deterministic correctness tests, and multi-container pipeline
# validation without GPU dependency. Dependencies install from uv.lock
# (--frozen), so the image reproduces the host dependency set exactly
# (spec 4.10); the CPU-only torch wheel comes from the pytorch-cpu index
# recorded in the lock.
#
# Models are mounted read-only, never baked (spec 21.1):
#
#   docker run --rm \
#     -v "$EDGESHARD_MODEL_CACHE:/models:ro" \
#     -v "$PWD/stage.yaml:/runtime/config/runtime.yaml:ro" \
#     -p 9100:9100 \
#     edgeshard/hf-shard:cpu
#
# The mounted runtime config must use container-side paths:
#   model.path under /models/...
#   server.listen_host: 0.0.0.0

FROM python:3.12-slim

# Pinned to the host uv version for lock compatibility.
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /uvx /usr/local/bin/

WORKDIR /app

# Dependency layer first for build caching.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"

ENTRYPOINT ["edgeshard"]
CMD ["--config", "/runtime/config/runtime.yaml"]
